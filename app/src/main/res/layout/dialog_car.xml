<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/car_name"
        android:inputType="text" />

    <EditText
        android:id="@+id/etNorm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/car_norm"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/etInitialOdometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/car_initial_odometer"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/etInitialFuel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/car_initial_fuel"
        android:inputType="numberDecimal" />
</LinearLayout>
