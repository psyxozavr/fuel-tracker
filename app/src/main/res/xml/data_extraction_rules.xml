<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Правила для облачного резервного копирования -->
    <cloud-backup>
        <include domain="database" path="fuel_tracker.db" />
    </cloud-backup>
    <!-- Правила для прямого переноса с устройства на устройство -->
    <device-transfer>
        <include domain="database" path="fuel_tracker.db" />
    </device-transfer>
</data-extraction-rules>
